# Money Manager — environment variables
#
# Copy to .env.local for local development, or set these in the Vercel project
# under Settings -> Environment Variables. NEVER commit a file with real values:
# .gitignore excludes .env and .env.local for exactly that reason.
#
# Every variable here is read on the server only. None of them is ever sent to
# a browser, embedded in the HTML, or referenced by client-side JavaScript.


# ---------------------------------------------------------------- required ---

# The Postgres connection string. This is the only required variable.
#
# Attaching a database from the Vercel dashboard (Storage -> Create ->
# Neon/Postgres -> Connect to project) sets this for you. Bringing your own
# (Supabase, RDS, a VPS) works too — paste the string here.
#
# It must be a UTF8 database, or it cannot store the rupee sign.
#
# These other names are also accepted, in this order, because each provider
# sets its own: POSTGRES_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED,
# POSTGRES_PRISMA_URL, NEON_DATABASE_URL, PG_CONNECTION_STRING.
#
# IMPORTANT: environment variables only reach the running app on the NEXT
# deployment. After setting this, redeploy — otherwise the app still reports
# that the database is unavailable.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require


# ---------------------------------------------------------------- optional ---

# Who may create an account. The site is on the public internet, so set this
# before sharing the URL.
#
#   set    -> only these addresses may register
#   unset  -> the FIRST account to register claims the deployment, and everyone
#             after it is refused. Safe for one person, but setting the list
#             explicitly is better, because it survives clearing the database.
# ALLOWED_EMAILS=you@example.com, partner@example.com

# Keys an HMAC over session tokens, so a stolen database dump contains nothing
# that can be replayed as a login without this value.
#
# Genuinely optional, and safe to add later: passwords do not depend on it, and
# the only consequence of adding, changing or losing it is that existing
# sessions stop matching and people sign in again.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=

# Enables the Google sign-in button. See server/GOOGLE-SETUP.md.
# GOOGLE_CLIENT_ID=1234....apps.googleusercontent.com

# How many snapshots to keep per account (default 40).
# KEEP_SNAPSHOTS=40

# Restrict which origins may call the API. Defaults to *, which is safe here
# because every route except /health is token-checked.
# CORS_ORIGIN=https://your-project.vercel.app

# Set to 1 ONLY if your provider's TLS certificate is not one Node trusts.
# Leaving it unset means the database connection's certificate is verified.
# PGSSL_NO_VERIFY=

# Include a sanitised technical reason alongside the safe error message, and in
# /api/health. Ignored when the deployment is production, so it cannot be left
# on by accident. For local debugging only.
# MM_DIAGNOSTICS=1


# --------------------------------------------------- password reset by email ---

# Enables "Forgot your password?" on the sign-in screen, which emails a
# six-digit code and a single-use link. Without both of these the feature is
# hidden and a forgotten password means the account is lost — a backup file
# (Settings -> Backup) is then the only way back in.
#
# Create a key at resend.com. MAIL_FROM must be an address at a domain you have
# verified there; onboarding@resend.dev works for testing but only delivers to
# the address that owns the Resend account.
# RESEND_API_KEY=re_...
# MAIL_FROM=Money Manager <mm@yourdomain.com>

# Where reset links point. On Vercel this is automatic — VERCEL_PROJECT_PRODUCTION_URL
# is used when APP_URL is unset. Set it if you serve the app from a custom domain.
#
# It is deliberately NOT taken from the request's Host header: otherwise anyone
# could ask for a reset with a spoofed Host and the account holder would receive
# a real token pointing at the attacker's site. With neither set, the email
# carries the code and omits the link.
# APP_URL=https://money-manager.example.com


# ------------------------------------------------------------- who may sign up ---

# Three explicit states, so the answer is never inferred:
#   open       anyone may create an account, subject to the limits below
#   closed     nobody may — what you want once your own accounts exist
#   allowlist  only the addresses in ALLOWED_EMAILS (the default when unset)
#
# NOTE: clearing ALLOWED_EMAILS does NOT open registration. With an account
# already in the database the fallback ("first account claims this deployment")
# refuses everybody. Use this switch instead.
# ALLOW_SIGNUPS=allowlist

# Limits that apply ONLY when ALLOW_SIGNUPS=open. Open registration on a public
# URL is an invitation to fill the database, so it ships with limits rather than
# without. Three buckets, because they stop different things:
#   SIGNUP_LIMIT_TRIES   attempts per caller per hour (default 10) — stops
#                        hammering; generous, so a typo does not lock anyone out
#   SIGNUP_LIMIT_IP_HOUR accounts actually created per caller per hour (3)
#   SIGNUP_LIMIT_IP_DAY  accounts per caller per day (5)
#   SIGNUP_LIMIT_HOUR    accounts per hour across the whole deployment (30) —
#                        the backstop for abuse spread over many addresses
# MAX_ACCOUNTS           a hard ceiling on total accounts (0 = no ceiling)
#
# The caller is identified from x-vercel-forwarded-for, which Vercel's edge
# writes and a client cannot forge. x-forwarded-for is only a fallback for other
# hosts — behind a different proxy, make sure it is trustworthy or the limits
# are decorative. Addresses are stored as an HMAC, never in the clear.
# SIGNUP_LIMIT_TRIES=10
# SIGNUP_LIMIT_IP_HOUR=3
# SIGNUP_LIMIT_IP_DAY=5
# SIGNUP_LIMIT_HOUR=30
# MAX_ACCOUNTS=0
